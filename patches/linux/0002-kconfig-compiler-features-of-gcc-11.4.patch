Build-only change, not for upstream: report the compiler features of gcc
11.4, which built the prebuilt Raspberry Pi kernel, instead of probing
our newer compiler.

With MODVERSIONS, a module only loads if the CRCs of the symbols it uses
match the kernel's. genksyms computes them from the preprocessed type
definitions, and those include attributes that depend on compiler
features: gcc 15 adds __counted_by__ to struct net_device, for example,
which changes the CRC of everything that reaches it (sockets, so all of
usbip-core's exports) without changing any layout. With these features
pinned, the preprocessed types match the Pi's build: build.sh checks
that the module's symbol CRCs equal the stock module's.

---
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -92,7 +92,7 @@
 config GCC_ASM_GOTO_OUTPUT_BROKEN
 	bool
 	depends on CC_IS_GCC
-	default y if GCC_VERSION < 110500
+	default y
 	default y if GCC_VERSION >= 120000 && GCC_VERSION < 120400
 	default y if GCC_VERSION >= 130000 && GCC_VERSION < 130300
 
@@ -123,8 +123,7 @@
 	default y if CC_IS_CLANG && CLANG_VERSION >= 190100
 	# supported since gcc 13.1.0
 	# https://gcc.gnu.org/bugzilla/show_bug.cgi?id=106654
-	default y if CC_IS_GCC && GCC_VERSION >= 130100
-
+	
 config CC_HAS_NO_PROFILE_FN_ATTR
 	def_bool $(success,echo '__attribute__((no_profile_instrument_function)) int x();' | $(CC) -x c - -c -o /dev/null -Werror)
 
@@ -137,10 +136,9 @@
 	default y if CC_IS_CLANG && CLANG_VERSION >= 200100
 	# supported since gcc 15.1.0
 	# https://gcc.gnu.org/bugzilla/show_bug.cgi?id=108896
-	default y if CC_IS_GCC && GCC_VERSION >= 150100
-
+	
 config CC_HAS_MULTIDIMENSIONAL_NONSTRING
-	def_bool $(success,echo 'char tag[][4] __attribute__((__nonstring__)) = { };' | $(CC) $(CLANG_FLAGS) -x c - -c -o /dev/null -Werror)
+	def_bool n && $(success,echo 'char tag[][4] __attribute__((__nonstring__)) = { };' | $(CC) $(CLANG_FLAGS) -x c - -c -o /dev/null -Werror)
 
 config LD_CAN_USE_KEEP_IN_OVERLAY
 	# ld.lld prior to 21.0.0 did not support KEEP within an overlay description
