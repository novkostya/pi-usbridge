# BusyBox applets for the production image. Applied on top of
# `make allnoconfig`: anything not listed here is left out.
# build.sh fails if one of these options doesn't end up in the final .config.

CONFIG_STATIC=y
CONFIG_BUSYBOX=y
CONFIG_LFS=y

# init: PID 1, reads /etc/inittab, respawns vhusbd
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y

# shell for /etc/rc and friends
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_FEATURE_SH_MATH=y

# the handful of tools the boot scripts use
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CMP=y
CONFIG_CP=y
CONFIG_HOSTNAME=y
CONFIG_INSMOD=y
CONFIG_LN=y
CONFIG_MKDIR=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_SLEEP=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_FLOAT_DURATION=y
CONFIG_SYNC=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_WATCHDOG=y

# networking
CONFIG_ARPING=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_UDHCPC=y
CONFIG_FEATURE_UDHCPC_ARPING=y
CONFIG_UDHCPC_DEFAULT_SCRIPT="/usr/share/udhcpc/default.script"
