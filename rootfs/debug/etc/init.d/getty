#!/bin/sh
# Root shell on the serial console: the tty of the last console= on the
# kernel command line (ttyAMA0 on GPIO14/15 with the debug config.txt).
set -- $(cat /sys/class/tty/console/active)
for tty; do :; done
if [ -z "$tty" ] || [ ! -c "/dev/$tty" ]; then
	exec sleep 2147483647
fi
exec getty -n -l /bin/sh -L 115200 "$tty" vt100
