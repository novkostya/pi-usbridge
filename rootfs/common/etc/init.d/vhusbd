#!/bin/sh
# Runs vhusbd in the foreground; init restarts it if it exits.

if [ ! -x /usr/sbin/vhusbd ]; then
	echo "vhusbd: /boot/vhusbdarm64 missing, copy it to the SD card" > /dev/console
	exec sleep 2147483647
fi

. /etc/functions

# Give DHCP up to 15s so the server announces itself on the right address.
i=0
while [ $i -lt 150 ]; do
	case "$(ip -4 -o addr show dev "$(netif)" 2>/dev/null)" in *inet*) break ;; esac
	sleep 0.1
	i=$((i + 1))
done

sleep 1 # don't spin if it crashes right away
cd /etc/vhusbd && exec /usr/sbin/vhusbd -c /etc/vhusbd/config.ini
