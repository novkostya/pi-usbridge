# Shared shell helpers.

# The green ACT LED shows state: blinking = no IP yet, solid = ready.
led() {
	for l in /sys/class/leds/ACT /sys/class/leds/led0; do
		[ -w "$l/trigger" ] && echo "$1" > "$l/trigger" 2>/dev/null && return
	done
}

# Boot milestone in the kernel log (`dmesg`), timestamped like kernel messages.
mark() {
	echo "vhusb: $*" > /dev/kmsg 2>/dev/null
}

# First network interface other than loopback (the HAT's NIC is eth0).
netif() {
	for n in /sys/class/net/*; do
		n=${n##*/}
		[ "$n" != lo ] && [ -e "/sys/class/net/$n" ] && echo "$n" && return
	done
}

# The gateway answered ARP within 200 ms ("Unicast reply from ... 0.672ms");
# the first reply counts, there can be duplicates. Sets $gw from /run/gateway.
gateway_answers() {
	gw=$(cat /run/gateway 2>/dev/null)
	[ -n "$gw" ] || return 1
	ms=
	for w in $(arping -c 1 -w 2 -I "$(netif)" "$gw" 2>/dev/null); do
		case $w in *ms) ms=${w%ms}; ms=${ms%.*}; break ;; esac
	done
	[ -n "$ms" ] && [ "$ms" -lt 200 ]
}

# Running a trial boot of a new version from /boot/next (scripts/deploy.sh).
trial() {
	[ "$(cat /proc/device-tree/chosen/os_prefix 2>/dev/null)" = next/ ]
}

# Variant-specific settings (the debug image sets extra options here).
[ -f /etc/variant.env ] && . /etc/variant.env
