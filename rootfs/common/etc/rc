#!/bin/sh
# One-shot boot script, run by init before anything else (see /etc/inittab).
# Everything lives in RAM; the SD card's boot partition is only mounted
# read-only to read settings (and the vhusbd binary, for VirtualHere).

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

. /etc/functions
led timer
mark "rc started"

# Lower latency: run the CPU at full speed instead of scaling on demand.
for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
	[ -w "$g" ] && echo performance > "$g"
done

# Kernel modules: Ethernet driver, under-voltage warnings, USB/IP.
for m in /lib/modules/*.ko; do
	[ -e "$m" ] && insmod "$m"
done

# Boot partition: settings, vhusbd binary and its config.
i=0
while [ ! -b /dev/mmcblk0p1 ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
if mount -t vfat -o ro,noatime,codepage=437,iocharset=ascii /dev/mmcblk0p1 /boot; then
	echo "rc: boot partition mounted"
else
	echo "rc: boot partition not found, using defaults"
fi

# /boot/usbridge.txt: key=value lines, see the template on the SD card.
hostname=usbridge ip=dhcp gateway='' dns='' mac='' netwatch=60 server=${SERVER_DEFAULT:-usbip} allow='' devices='' rtprio=0
if [ -f /boot/usbridge.txt ]; then
	cr=$(printf '\r')
	while IFS='=' read -r key val || [ -n "$key" ]; do
		val=${val%%#*}
		val=${val%"$cr"}
		# shellcheck disable=SC2086 # split to trim whitespace
		set -- $val
		case "$key" in
			hostname|ip|gateway|dns|mac|netwatch|server|rtprio) [ -n "$1" ] && eval "$key=\$1" ;;
			allow|devices) eval "$key=\$*" ;;
		esac
	done < /boot/usbridge.txt
fi
hostname "$hostname"
echo "$hostname" > /etc/hostname
echo "$netwatch" > /run/netwatch
echo "$server" > /run/server
echo "$allow" > /run/allow
echo "$devices" > /run/devices
echo "$rtprio" > /run/rtprio

# A trial boot of a new version (see /etc/init.d/trial) tries its vhusbd too.
vhusbd=/boot/vhusbdarm64
trial && [ -f /boot/next/vhusbdarm64 ] && vhusbd=/boot/next/vhusbdarm64
if [ -f "$vhusbd" ]; then
	cp "$vhusbd" /usr/sbin/vhusbd && chmod 755 /usr/sbin/vhusbd
fi
[ -f /boot/config.ini ] && cp /boot/config.ini /etc/vhusbd/config.ini

[ -x /etc/rc.debug ] && /etc/rc.debug

# Network. The USB hub and NIC on the HAT take a moment to enumerate; use
# the first interface that shows up (eth0 for the HAT's RTL8152).
ip link set lo up
i=0
while [ $i -lt 100 ]; do
	iface=$(netif)
	[ -n "$iface" ] && break
	sleep 0.1
	i=$((i + 1))
done
if [ -z "$iface" ]; then
	echo "rc: no network interface, is the HAT connected?"
	exit 0
fi
echo "rc: using $iface"
mark "$iface appeared"

if [ "$mac" = serial ]; then
	# Stable locally administered MAC derived from the Pi's serial number.
	s=$(cat /proc/device-tree/serial-number 2>/dev/null)
	s=${s:$((${#s} - 10))}
	[ ${#s} -eq 10 ] && mac=02:${s:0:2}:${s:2:2}:${s:4:2}:${s:6:2}:${s:8:2}
fi
[ -n "$mac" ] && [ "$mac" != serial ] && ip link set "$iface" address "$mac"
ip link set "$iface" up

if [ "$ip" = dhcp ]; then
	# Start as soon as the link is up (auto-negotiation takes ~2s), so the
	# first discover goes out right away; then one per second until
	# answered. No -R (release on exit): keeping the lease lets dnsmasq
	# answer at once on the next boot instead of first pinging the address
	# for ~3s as it does for a new client.
	(
		i=0
		while [ "$(cat "/sys/class/net/$iface/carrier" 2>/dev/null)" != 1 ] && [ $i -lt 200 ]; do
			sleep 0.05
			i=$((i + 1))
		done
		# shellcheck disable=SC2086 # UDHCPC_OPTS holds options
		exec udhcpc -f -i "$iface" -x "hostname:$hostname" -t 10 -T 1 -A 1 $UDHCPC_OPTS
	) </dev/null >/dev/null 2>&1 &
else
	case $ip in */*) ;; *) ip=$ip/24 ;; esac
	ip addr add "$ip" dev "$iface"
	[ -n "$gateway" ] && ip route add default via "$gateway" && echo "$gateway" > /run/gateway
	[ -n "$dns" ] && echo "nameserver $dns" > /etc/resolv.conf
	led default-on
fi
echo "rc: done"
